<?xml version="1.0"?>
<MenuItems>
    <MenuItem id="installMatterServer">
        <Name>Install/update matter-server</Name>
        <CallbackMethod>menuInstallMatterServer</CallbackMethod>
    </MenuItem>
    <MenuItem id="restartMatterServer">
        <Name>Restart matter-server</Name>
        <CallbackMethod>menuRestartMatterServer</CallbackMethod>
    </MenuItem>
    <MenuItem id="reinstallMatterServerClean">
        <Name>Reinstall matter-server (clean)…</Name>
        <CallbackMethod>menuReinstallMatterServerClean</CallbackMethod>
        <ConfigUI>
            <Field id="warning" type="label">
                <Label>Deletes the installed matter-server package (~/indigo-matter/node_modules) and reinstalls it fresh, then restarts. Your commissioned devices are NOT affected — the fabric/storage is left untouched. Use this if matter-server won't start after an upgrade (e.g. a wedged install or a "Storage is locked" error).</Label>
            </Field>
            <Field id="confirm" type="checkbox" defaultValue="false">
                <Label>I understand this reinstalls matter-server (devices/pairings are kept).</Label>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="showMatterServerLogs">
        <Name>Open matter-server log…</Name>
        <CallbackMethod>menuShowMatterServerLogs</CallbackMethod>
    </MenuItem>
    <MenuItem id="commissionDeviceManually">
        <Name>Commission device by setup code (advanced)…</Name>
        <CallbackMethod>menuCommissionDeviceManually</CallbackMethod>
        <ConfigUI>
            <Field id="setupCode" type="textfield">
                <Label>Setup code (MT:... or 11 digits):</Label>
            </Field>
            <Field id="suggestedName" type="textfield">
                <Label>Name:</Label>
            </Field>
            <Field id="folder" type="menu">
                <Label>Folder:</Label>
                <List class="self" method="getDeviceFolders" dynamicReload="true"/>
                <Description>Where the new Indigo device(s) land. Leave as "(no folder)" for the device-list root.</Description>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="decommissionDevice">
        <Name>Decommission Matter device…</Name>
        <CallbackMethod>menuDecommissionDevice</CallbackMethod>
        <ConfigUI>
            <Field id="warning" type="label">
                <Label>Removes the device from Indigo's Matter fabric and deletes its Indigo device(s). The device stays in Apple Home and any other ecosystem. Note: deleting the Indigo device alone does NOT do this — the plugin recreates it when it next reconciles with matter-server.</Label>
            </Field>
            <Field id="node" type="menu">
                <Label>Device (Matter node):</Label>
                <List class="self" method="getMatterNodes" dynamicReload="true"/>
            </Field>
            <Field id="confirm" type="checkbox" defaultValue="false">
                <Label>I understand this removes the device from Indigo (other ecosystems are unaffected).</Label>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="exportFabricBackup">
        <Name>Export fabric backup…</Name>
        <CallbackMethod>menuExportFabricBackup</CallbackMethod>
    </MenuItem>
    <MenuItem id="restoreFabricBackup">
        <Name>Restore fabric backup…</Name>
        <CallbackMethod>menuRestoreFabricBackup</CallbackMethod>
        <ConfigUI>
            <Field id="warning" type="label">
                <Label>Restoring REPLACES the current fabric and restarts matter-server. The current fabric is moved aside (not deleted) so a bad restore is reversible. Requires 'Manage LaunchAgent' to be on.</Label>
            </Field>
            <Field id="backup" type="menu">
                <Label>Backup to restore:</Label>
                <List class="self" method="getFabricBackups"/>
            </Field>
            <Field id="confirm" type="checkbox" defaultValue="false">
                <Label>I understand this replaces the current fabric and will restart matter-server.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>
</MenuItems>
