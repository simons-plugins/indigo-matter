<?xml version="1.0"?>
<!-- Matter device type catalog (v1 cluster scope).
     Each Matter endpoint maps to one Indigo device via the cluster mapping
     layer (see matter_handlers/). The readonly identity fields are populated
     from the Matter node at commissioning time and refreshed on interview. -->
<Devices>

    <!-- ============================================================ -->
    <!-- Lighting                                                     -->
    <!-- ============================================================ -->

    <!-- Relay: OnOff only -->
    <Device id="matterRelay" type="relay">
        <Name>Matter Relay</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <!-- onOffState is native to the relay base type — do not redefine it
             (Indigo rejects "native state keys cannot be overriden"). -->
        <UiDisplayStateId>onOffState</UiDisplayStateId>
    </Device>

    <!-- Dimmer: OnOff + LevelControl -->
    <Device id="matterDimmer" type="dimmer">
        <Name>Matter Dimmer</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <!-- States inherited from dimmer base type: onOffState, brightnessLevel -->
    </Device>

    <!-- Color dimmer: OnOff + LevelControl + ColorControl -->
    <Device id="matterColorDimmer" type="dimmer">
        <Name>Matter Color Dimmer</Name>
        <SupportsColor>true</SupportsColor>
        <SupportsRGB>true</SupportsRGB>
        <SupportsWhite>true</SupportsWhite>
        <SupportsWhiteTemperature>true</SupportsWhiteTemperature>
        <SupportsRGBandWhiteSimultaneously>false</SupportsRGBandWhiteSimultaneously>
        <WhiteTemperatureMin>2000</WhiteTemperatureMin>
        <WhiteTemperatureMax>6500</WhiteTemperatureMax>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <States>
            <!-- ColorCapabilities bitmap (attr 0x400A): bit0 HS, bit1 EnhancedHue,
                 bit2 ColorLoop, bit3 XY, bit4 ColorTemperature. Cached so
                 handle_indigo_action can pick MoveToHueAndSaturation vs
                 MoveToColor — HS is OPTIONAL per spec even on Extended Color
                 Lights (issue #60). -->
            <State id="colorCapabilities">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Color Capabilities</TriggerLabel>
                <ControlPageLabel>Color Capabilities</ControlPageLabel>
            </State>
            <!-- Raw CIE xy (attrs 0x0003/0x0004, 0-65535 scale) - XY-mode
                 devices report these instead of hue/saturation; kept so a
                 one-axis update can recompute RGB from both. -->
            <State id="colorX">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Color X</TriggerLabel>
                <ControlPageLabel>Color X</ControlPageLabel>
            </State>
            <State id="colorY">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Color Y</TriggerLabel>
                <ControlPageLabel>Color Y</ControlPageLabel>
            </State>
        </States>
    </Device>

