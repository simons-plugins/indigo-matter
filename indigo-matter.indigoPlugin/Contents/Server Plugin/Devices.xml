<?xml version="1.0"?>
<!-- Matter device type catalog (v1 cluster scope).
     Each Matter endpoint maps to one Indigo device via the cluster mapping
     layer (see matter_handlers/). The readonly identity fields are populated
     from the Matter node at commissioning time and refreshed on interview. -->
<Devices>

    <!-- ============================================================ -->
    <!-- Lighting                                                     -->
    <!-- ============================================================ -->

    <!-- Relay: OnOff only -->
    <Device id="matterRelay" type="relay">
        <Name>Matter Relay</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
            <!-- Writable device settings (issue #186) — OnOff's Lighting-feature
                 attribute (conformance LT). "Implements the Lighting feature"
                 is NOT the same as "is a light": of four plugs on the dev
                 fabric two carry it and two do not, so the hasX markers,
                 which getDeviceConfigUiValues sets from the device's OWN
                 AttributeList, are doing real work here.
                 An "Auto-off after" field lived here and was withdrawn: OnTime
                 is a parameter of OnWithTimedOff, not a setting, so the field
                 could never do anything (#197, ADR-0005). -->
            <Field id="hasStartUpOnOff" type="textfield" hidden="true" defaultValue="no"/>
            <Field id="hasAnySetting" type="textfield" hidden="true" defaultValue="no"/>
            <Field id="settingsSeparator" type="separator"
                   visibleBindingId="hasAnySetting" visibleBindingValue="yes"/>
            <Field id="settingsHeading" type="label" fontColor="darkgray"
                   visibleBindingId="hasAnySetting" visibleBindingValue="yes">
                <Label>Device Settings — stored on the device itself, not in Indigo. Changing one changes how the device behaves for EVERY app it is paired with, including Apple Home.</Label>
            </Field>
            <Field id="startUpOnOff" type="menu"
                   visibleBindingId="hasStartUpOnOff" visibleBindingValue="yes">
                <Label>After a power cut:</Label>
                <List class="self" method="getSettingOptions" filter="startUpOnOff" dynamicReload="true"/>
            </Field>
        </ConfigUI>
        <!-- onOffState is native to the relay base type — do not redefine it
             (Indigo rejects "native state keys cannot be overriden"). -->
        <States>
            <!-- OnOff Lighting-feature setting (issue #186). A state rather than
                 a prop alone so the dialog can show the current value without a
                 live read, and so a change made from another ecosystem lands.
                 Declared for the TYPE; getDeviceStateList removes it per unit
                 when the device's own AttributeList says it does not implement
                 the attribute (#190).
                 An onTime state was declared here and REMOVED in the release
                 following v2026.10.1 — removing a state breaks any trigger bound
                 to it, which is why the plugin logs the removal once (#197). -->
            <State id="startUpOnOff">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Power-On Behaviour</TriggerLabel>
                <ControlPageLabel>Power-On Behaviour</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>onOffState</UiDisplayStateId>
    </Device>

    <!-- Dimmer: OnOff + LevelControl -->
    <Device id="matterDimmer" type="dimmer">
        <Name>Matter Dimmer</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <!-- States inherited from dimmer base type: onOffState, brightnessLevel -->
    </Device>

    <!-- Color dimmer: OnOff + LevelControl + ColorControl -->
    <Device id="matterColorDimmer" type="dimmer">
        <Name>Matter Color Dimmer</Name>
        <SupportsColor>true</SupportsColor>
        <SupportsRGB>true</SupportsRGB>
        <SupportsWhite>true</SupportsWhite>
        <SupportsWhiteTemperature>true</SupportsWhiteTemperature>
        <SupportsRGBandWhiteSimultaneously>false</SupportsRGBandWhiteSimultaneously>
        <WhiteTemperatureMin>2000</WhiteTemperatureMin>
        <WhiteTemperatureMax>6500</WhiteTemperatureMax>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <States>
            <!-- ColorCapabilities bitmap (attr 0x400A): bit0 HS, bit1 EnhancedHue,
                 bit2 ColorLoop, bit3 XY, bit4 ColorTemperature. Cached so
                 handle_indigo_action can pick MoveToHueAndSaturation vs
                 MoveToColor — HS is OPTIONAL per spec even on Extended Color
                 Lights (issue #60). -->
            <State id="colorCapabilities">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Color Capabilities</TriggerLabel>
                <ControlPageLabel>Color Capabilities</ControlPageLabel>
            </State>
            <!-- Raw CIE xy (attrs 0x0003/0x0004, 0-65535 scale) - XY-mode
                 devices report these instead of hue/saturation; kept so a
                 one-axis update can recompute RGB from both. -->
            <State id="colorX">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Color X</TriggerLabel>
                <ControlPageLabel>Color X</ControlPageLabel>
            </State>
            <State id="colorY">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Color Y</TriggerLabel>
                <ControlPageLabel>Color Y</ControlPageLabel>
            </State>
        </States>
    </Device>

