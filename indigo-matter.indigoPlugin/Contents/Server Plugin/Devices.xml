    <!-- ============================================================ -->
    <!-- Thermostat                                                   -->
    <!-- ============================================================ -->

    <Device id="matterThermostat" type="thermostat">
        <Name>Matter Thermostat</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
            <!-- Thermostat capability flags — set from the Matter device's
                 clusters at creation; declared here so Indigo builds the
                 matching states. -->
            <Field id="NumTemperatureInputs" type="textfield" defaultValue="1" hidden="yes" />
            <Field id="NumHumidityInputs" type="textfield" defaultValue="0" hidden="yes" />
            <Field id="SupportsHeatSetpoint" type="checkbox" defaultValue="true" hidden="yes" />
            <Field id="SupportsCoolSetpoint" type="checkbox" defaultValue="true" hidden="yes" />
            <Field id="SupportsHvacOperationMode" type="checkbox" defaultValue="true" hidden="yes" />
            <Field id="SupportsHvacFanMode" type="checkbox" defaultValue="true" hidden="yes" />
            <Field id="ShowCoolHeatEquipmentStateUI" type="checkbox" defaultValue="true" hidden="yes" />
        </ConfigUI>
        <!-- States inherited from thermostat base: hvacOperationMode,
             hvacFanMode, temperatureInput1, setpointHeat, setpointCool, etc. -->
    </Device>

    <!-- ============================================================ -->
    <!-- Window Covering                                              -->
    <!-- ============================================================ -->

    <!-- Window covering: blinds / shades / curtains (WindowCovering cluster 0x0102).
         Mapped as a dimmer: brightness 100 = fully open, 0 = fully closed. -->
    <Device id="matterWindowCovering" type="dimmer">
        <Name>Matter Window Covering</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <!-- States inherited from dimmer base type: onOffState, brightnessLevel -->
    </Device>

    <!-- ============================================================ -->
    <!-- Door Lock                                                    -->
    <!-- DoorLockHandler (matter_handlers/door_lock.py)              -->
    <!-- on = locked, off = unlocked — relay type gives lock/unlock  -->
    <!-- buttons, triggers, and control-page support natively.       -->
    <!-- Custom lockState string state for finer trigger conditions.  -->
    <!-- ============================================================ -->

    <Device id="matterLock" type="relay">
        <Name>Matter Lock</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <States>
            <State id="onOffState">
                <ValueType boolType="OnOff">Boolean</ValueType>
                <TriggerLabel>On/Off State</TriggerLabel>
                <ControlPageLabel>On/Off State</ControlPageLabel>
            </State>
            <!-- lockState: finer trigger granularity beyond the binary on/off.
                 Values: locked / unlocked / jammed (NotFullyLocked).
                 NOTE: jammed currently maps to off + lockState="jammed"; surfacing
                 it as an Indigo error state (setErrorStateOnServer) needs a
                 handler-contract change and is deliberately deferred. -->
            <State id="lockState">
                <ValueType>String</ValueType>
                <TriggerLabel>Lock State</TriggerLabel>
                <ControlPageLabel>Lock State</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>onOffState</UiDisplayStateId>
    </Device>

    <!-- ============================================================ -->
    <!-- Fan                                                         -->
    <!-- ============================================================ -->

    <!-- Standalone fan: FanControl (0x0202) without a co-located Thermostat.
         Uses the dimmer type so brightness = fan speed % and on/off are native.
         (When FanControl is co-located with Thermostat it merges into
         matterThermostat — no separate device is created in that case.) -->
    <Device id="matterFan" type="dimmer">
        <Name>Matter Fan</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <!-- States inherited from dimmer base type: onOffState, brightnessLevel -->
    </Device>

    <!-- ============================================================ -->
    <!-- Smoke / CO Alarm                                             -->
    <!-- ============================================================ -->

    <!-- SmokeCOAlarm cluster (0x005C).
         onOffState is True only for active smoke/CO alarm conditions
         (ExpressedState ∈ SmokeAlarm/COAlarm/InterconnectSmoke/InterconnectCO).
         batteryLevel is declared now and will be populated once issue #3's
         PowerSource handler lands (harmless until then). -->
    <Device id="matterSmokeCOAlarm" type="sensor">
        <Name>Matter Smoke/CO Alarm</Name>
        <ConfigUI>
            <Field id="nodeId" type="textfield" readonly="yes">
                <Label>Matter Node ID:</Label>
            </Field>
            <Field id="endpointId" type="textfield" readonly="yes">
                <Label>Endpoint:</Label>
            </Field>
            <Field id="vendorName" type="textfield" readonly="yes">
                <Label>Vendor:</Label>
            </Field>
            <Field id="productName" type="textfield" readonly="yes">
                <Label>Product:</Label>
            </Field>
        </ConfigUI>
        <States>
            <State id="onOffState">
                <ValueType boolType="OnOff">Boolean</ValueType>
                <TriggerLabel>Alarm</TriggerLabel>
                <ControlPageLabel>Alarm</ControlPageLabel>
            </State>
            <State id="expressedState">
                <ValueType>String</ValueType>
                <TriggerLabel>Expressed State</TriggerLabel>
                <ControlPageLabel>Expressed State</ControlPageLabel>
            </State>
            <State id="smokeAlarm">
                <ValueType boolType="YesNo">Boolean</ValueType>
                <TriggerLabel>Smoke Alarm</TriggerLabel>
                <ControlPageLabel>Smoke Alarm</ControlPageLabel>
            </State>
            <State id="coAlarm">
                <ValueType boolType="YesNo">Boolean</ValueType>
                <TriggerLabel>CO Alarm</TriggerLabel>
                <ControlPageLabel>CO Alarm</ControlPageLabel>
            </State>
            <State id="batteryAlert">
                <ValueType boolType="YesNo">Boolean</ValueType>
                <TriggerLabel>Battery Alert</TriggerLabel>
                <ControlPageLabel>Battery Alert</ControlPageLabel>
            </State>
            <State id="endOfService">
                <ValueType boolType="YesNo">Boolean</ValueType>
                <TriggerLabel>End of Service</TriggerLabel>
                <ControlPageLabel>End of Service</ControlPageLabel>
            </State>
            <State id="batteryLevel">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Battery Level</TriggerLabel>
                <ControlPageLabel>Battery Level</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>onOffState</UiDisplayStateId>
    </Device>

