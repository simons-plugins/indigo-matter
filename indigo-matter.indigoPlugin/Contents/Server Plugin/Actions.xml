<?xml version="1.0"?>
<!-- Device control (on/off, brightness, color, thermostat setpoints/modes) is
     provided by Indigo for the built-in device types and routed via
     actionControlDevice / actionControlSensor / actionControlThermostat, then
     dispatched through the cluster mapping layer. BooleanStateConfiguration's
     sensitivity level (issue #85) has no Indigo built-in action shape (an
     arbitrary numeric picker), so it is the plugin's first custom device
     action below.

     The uiPath="hidden" actions below are the Domio HTTP API (API.md v1.1),
     served by the Indigo Web Server (IWS) at
       …/message/com.simons-plugins.indigo-matter/{handler}[/{pathArg}]
     reachable locally on :8176 and remotely via the Reflector with the same
     Bearer API key Domio already uses. Auth is enforced by Indigo before the
     handler runs. -->
<Actions>
    <!-- Indigo's deviceFilter takes exactly ONE filter (comma lists match
         nothing — live-verified 2026-07-06), so the sensitivity action is two
         type-scoped entries sharing one callback: motion (the Aqara FP300
         pairing) and contact (the Matter spec's BooleanState pairing). -->
    <Action id="setSensitivityLevel"
            deviceFilter="self.matterMotionSensor" uiPath="DeviceActions">
        <Name>Set Sensitivity Level</Name>
        <CallbackMethod>actionSetSensitivityLevel</CallbackMethod>
        <ConfigUI>
            <Field id="level" type="menu">
                <Label>Sensitivity Level:</Label>
                <List class="self" method="getSensitivityLevels" dynamicReload="true"/>
            </Field>
        </ConfigUI>
    </Action>
    <Action id="setSensitivityLevelContact"
            deviceFilter="self.matterContactSensor" uiPath="DeviceActions">
        <Name>Set Sensitivity Level (Contact Sensor)</Name>
        <CallbackMethod>actionSetSensitivityLevel</CallbackMethod>
        <ConfigUI>
            <Field id="level" type="menu">
                <Label>Sensitivity Level:</Label>
                <List class="self" method="getSensitivityLevels" dynamicReload="true"/>
            </Field>
        </ConfigUI>
    </Action>
    <!-- Device-targeted twin of the "Report settable Matter settings…" menu
         item (issue #204): reaches the same on-demand
         report_settable_attributes(force=True) path from a control page,
         trigger, or action group, scoped to the one node this matterNode
         device already names. -->
    <Action id="reportNodeSettings" deviceFilter="self.matterNode" uiPath="DeviceActions">
        <Name>Report this node's settable attributes</Name>
        <CallbackMethod>actionReportNodeSettings</CallbackMethod>
    </Action>
    <!-- Issue #293's calibration extension (ADR-0014 Option C, rejected as an
         AUTOMATIC mechanism, now shipped as an explicit, operator-invoked
         one): sweeps CT-capable exports through both colour-temperature
         extremes and persists whatever the device echoes back through
         ct_learner's own adoption path — closing the gap the passive
         mechanism cannot: an unseeded lamp Indigo never drives through a
         paired ecosystem has no commanded reference to learn a shortfall
         against, however many times its colour temperature changes. Not
         deviceFilter-scoped — deviceFilter offers exactly ONE picker and
         cannot ALSO offer "every CT export", which the scope field below
         does via its own dynamic list. -->
    <Action id="calibrateCtBounds">
        <Name>Calibrate Colour-Temperature Bounds</Name>
        <CallbackMethod>actionCalibrateCtBounds</CallbackMethod>
        <ConfigUI>
            <Field id="scope" type="menu" defaultValue="all">
                <Label>Sweep:</Label>
                <List class="self" method="getCtCalibrationScope" dynamicReload="true"/>
            </Field>
            <Field id="skipLit" type="checkbox" defaultValue="true">
                <Label>Skip lamps that are currently on:</Label>
                <Description>A lit lamp visibly shifts colour during the sweep; an off lamp
                    does not light at all (issue #281's off-lamp-safe colour-temperature
                    write).</Description>
            </Field>
        </ConfigUI>
    </Action>
    <!-- Device-targeted twin of "Share a Matter device with another
         ecosystem…" (Plugins ▸ Matter, issue #210): opens a commissioning
         window on this node so a second ecosystem can add it too, reachable
         from a control page, trigger, or action group. Outcome only ever
         goes to the log — an action has no dialog to report into. -->
    <Action id="shareMatterNode" deviceFilter="self.matterNode" uiPath="DeviceActions">
        <Name>Share this device with another ecosystem</Name>
        <CallbackMethod>actionShareMatterNode</CallbackMethod>
        <ConfigUI>
            <Field id="duration" type="textfield" defaultValue="900">
                <Label>Window stays open for (seconds):</Label>
                <Description>Matter allows 180 to 900 (3 to 15 minutes). 900 is the maximum and the default.</Description>
            </Field>
        </ConfigUI>
    </Action>
    <Action id="status" uiPath="hidden">
        <Name>matter status</Name>
        <CallbackMethod>http_status</CallbackMethod>
    </Action>
    <Action id="commission" uiPath="hidden">
        <Name>matter commission</Name>
        <CallbackMethod>http_commission</CallbackMethod>
    </Action>
    <Action id="decommission" uiPath="hidden">
        <Name>matter decommission</Name>
        <CallbackMethod>http_decommission</CallbackMethod>
    </Action>
    <Action id="diagnostics" uiPath="hidden">
        <Name>matter device diagnostics</Name>
        <CallbackMethod>http_diagnostics</CallbackMethod>
    </Action>
    <!-- The export bridge's pairing page (PRD-indigo-matter-export §6). The one
         handler here that returns HTML rather than JSON: it exists because the
         event log can carry a pairing code but not a QR code. Same IWS auth as
         the Domio handlers above. -->
    <Action id="pairing" uiPath="hidden">
        <Name>matter export pairing page</Name>
        <CallbackMethod>http_pairing</CallbackMethod>
    </Action>
</Actions>
